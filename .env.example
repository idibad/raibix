APP_NAME="LMS Cloud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Central Database Connection
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lms_central
# DB_USERNAME=root
# DB_PASSWORD=

# Multi-Tenancy Configuration
TENANT_DOMAIN_SUFFIX=localhost

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@lms.local"
MAIL_FROM_NAME="${APP_NAME}"

# Third-Party Payments (Local / Sandbox)
STRIPE_KEY=pk_test_placeholder
STRIPE_SECRET=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

JAZZCASH_MERCHANT_ID=MC12345
JAZZCASH_PASSWORD=test_pass
JAZZCASH_INTEGRITY_SALT=test_salt
JAZZCASH_RETURN_URL="http://localhost:8000/parent/payment/callback"

# SMS & WhatsApp Notifications (Local Mock)
SMS_PROVIDER=mock
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
URDUBIT_API_KEY=

WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

VITE_APP_NAME="${APP_NAME}"
