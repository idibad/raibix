APP_NAME="LMS Cloud"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lms.cloud

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Central Production Database (MySQL 8.0+ / PostgreSQL 15+)
DB_CONNECTION=mysql
DB_HOST=production-db.internal
DB_PORT=3306
DB_DATABASE=lms_production_central
DB_USERNAME=lms_prod_admin
DB_PASSWORD=strict_production_db_password
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/rds-combined-ca-bundle.pem

# Multi-Tenancy Production Configuration
TENANT_DOMAIN_SUFFIX=lms.cloud

# Production Session & Cookie Hardening
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.lms.cloud
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Production Cache, Queue & Storage
BROADCAST_CONNECTION=redis
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=lms_prod_cache:

# Production Redis Cluster / Sentinel
REDIS_CLIENT=phpredis
REDIS_HOST=production-redis.internal
REDIS_PASSWORD=strict_redis_auth_token
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3

# Production Mail Delivery
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@lms.cloud
MAIL_PASSWORD=production_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@lms.cloud"
MAIL_FROM_NAME="${APP_NAME}"

# Production AWS S3 Object Storage
AWS_ACCESS_KEY_ID=production_aws_access_key
AWS_SECRET_ACCESS_KEY=production_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=lms-production-storage
AWS_USE_PATH_STYLE_ENDPOINT=false

# Third-Party Payments (Live Production Credentials)
STRIPE_KEY=pk_live_production_key
STRIPE_SECRET=sk_live_production_secret
STRIPE_WEBHOOK_SECRET=whsec_live_production_secret

JAZZCASH_MERCHANT_ID=MC_LIVE_MERCHANT
JAZZCASH_PASSWORD=live_merchant_password
JAZZCASH_INTEGRITY_SALT=live_integrity_salt
JAZZCASH_RETURN_URL="https://lms.cloud/parent/payment/callback"

# Production Notification Gateways
SMS_PROVIDER=twilio
TWILIO_SID=AC_production_sid
TWILIO_TOKEN=production_token
TWILIO_FROM="+1234567890"

WHATSAPP_PROVIDER=cloud_api
WHATSAPP_TOKEN=production_whatsapp_token
WHATSAPP_PHONE_ID=production_phone_id

VITE_APP_NAME="${APP_NAME}"
