APP_NAME="LMS Cloud (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.lms.cloud

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=info

# Central Database Connection (MySQL / PostgreSQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms_staging_central
DB_USERNAME=lms_staging_user
DB_PASSWORD=staging_secret_password

# Multi-Tenancy Configuration
TENANT_DOMAIN_SUFFIX=staging.lms.cloud

# Session & Cookie Hardening
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.staging.lms.cloud
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Cache, Queue & Storage
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=lms_staging_cache:

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=staging_redis_secret
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=staging_postmaster@staging.lms.cloud
MAIL_PASSWORD=mailgun_staging_secret
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@staging.lms.cloud"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 Storage
AWS_ACCESS_KEY_ID=staging_aws_key
AWS_SECRET_ACCESS_KEY=staging_aws_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=lms-staging-storage
AWS_USE_PATH_STYLE_ENDPOINT=false

# Third-Party Payments (Stripe & JazzCash Sandbox)
STRIPE_KEY=pk_test_staging
STRIPE_SECRET=sk_test_staging
STRIPE_WEBHOOK_SECRET=whsec_staging

JAZZCASH_MERCHANT_ID=MC_STAGING
JAZZCASH_PASSWORD=staging_pass
JAZZCASH_INTEGRITY_SALT=staging_salt
JAZZCASH_RETURN_URL="https://staging.lms.cloud/parent/payment/callback"

# Notifications (Sandbox / Staging)
SMS_PROVIDER=twilio
TWILIO_SID=AC_staging
TWILIO_TOKEN=staging_token
TWILIO_FROM="+1234567890"

WHATSAPP_PROVIDER=cloud_api
WHATSAPP_TOKEN=staging_whatsapp_token
WHATSAPP_PHONE_ID=staging_phone_id

VITE_APP_NAME="${APP_NAME}"
